#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "version.h"

#pragma code_page(65001)

IDI_APP ICON "app.ico"
IDR_MANIFEST RT_MANIFEST "panel.manifest"

// ------------------------------------------------------------------------------------
IDD_MAIN DIALOGEX 0, 0, 630, 348
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME | WS_CLIPCHILDREN
CAPTION "PN-A2DP Control Panel"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "PN-A2DP", IDC_BRAND, 7, 6, 195, 20
    LTEXT           "", IDC_BRAND_VERSION, 7, 24, 195, 12, SS_NOPREFIX
    LTEXT           "Bluetooth audio, tuned for you", IDC_BRAND_SUB, 7, 36, 195, 14
    LTEXT           "Select a device", IDC_OUTPUT_TITLE, 210, 6, 400, 24, SS_NOPREFIX
    LTEXT           "", IDC_OUTPUT_SUMMARY, 210, 32, 400, 22, SS_NOPREFIX
    LTEXT           "YOUR DEVICES", IDC_DEVICE_LABEL, 7, 46, 195, 12
    CONTROL         "", IDC_DEVICES, WC_LISTVIEW, WS_TABSTOP | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER, 7, 60, 195, 222
    PUSHBUTTON      "Connect", IDC_BT_CONNECT, 7, 286, 56, 14
    PUSHBUTTON      "Disconnect", IDC_BT_DISCONNECT, 146, 286, 56, 14
    PUSHBUTTON      "Refresh", IDC_REFRESH, 7, 302, 56, 14
    PUSHBUTTON      "About", IDC_ABOUT, 146, 302, 56, 14
    CONTROL         "", IDC_TAB, WC_TABCONTROL, WS_TABSTOP | WS_CLIPSIBLINGS | TCS_OWNERDRAWFIXED, 210, 58, 413, 240
    CONTROL         "&Apply changes", IDC_APPLY, "Button", BS_OWNERDRAW | WS_TABSTOP, 342, 302, 48, 14
    PUSHBUTTON      "Undo changes", IDC_REVERT, 394, 302, 48, 14
    PUSHBUTTON      "Defaults", IDC_DEFAULTS, 446, 302, 48, 14
    PUSHBUTTON      "Import...", IDC_IMPORT, 498, 302, 48, 14
    PUSHBUTTON      "Export...", IDC_EXPORT, 550, 302, 48, 14
    LTEXT           "All changes saved", IDC_SAVE_HINT, 210, 300, 150, 12
    LTEXT           "", IDC_STATUSTEXT, 7, 322, 616, 20, SS_NOPREFIX
END

// ------------------------------------------------------------------------------------
IDD_PAGE_QUALITY DIALOGEX 0, 0, 400, 262
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Waiting for observations", IDC_QUALITY_TITLE, 4, 3, 212, 13, SS_NOPREFIX
    LTEXT           "", IDC_QUALITY_BITRATE, 218, 3, 178, 13, SS_NOPREFIX | SS_RIGHT
    LTEXT           "", IDC_QUALITY_REASON, 4, 20, 392, 28, SS_NOPREFIX
    LTEXT           "", IDC_QUALITY_RECENT, 4, 50, 392, 14, SS_NOPREFIX
    CONTROL         "Bitrate history; up to 60 seconds. Text measurements are above.", IDC_QUALITY_GRAPH, "Static", SS_OWNERDRAW, 4, 67, 392, 45
    LTEXT           "Check this device without changing settings or playing a tone.", IDC_HEALTH_TIMESTAMP, 4, 118, 392, 14, SS_NOPREFIX
    EDITTEXT        IDC_HEALTH_RESULTS, 4, 136, 392, 96, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Check my audio", IDC_HEALTH_CHECK, 4, 240, 88, 18
    PUSHBUTTON      "Export diagnostics...", IDC_HEALTH_EXPORT, 98, 240, 96, 18
    PUSHBUTTON      "Open suggested settings", IDC_HEALTH_FIX, 200, 240, 136, 18
    PUSHBUTTON      "Events...", IDC_QUALITY_EVENTS, 342, 240, 54, 18
END

IDD_QUALITY_EVENTS DIALOGEX 0, 0, 440, 288
STYLE DS_SETFONT | DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PN-A2DP - Quality events and recovery"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT "Recent changes for this device; newest first. Times show when changes were observed.", -1, 10, 8, 420, 20
    EDITTEXT IDC_EVENT_TEXT, 10, 32, 420, 170, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "Optional recovery: after persistent aptX trouble, try your configured SBC settings with adaptive bitrate enabled. This saves SBC as first preference and may briefly interrupt audio. Other settings stay unchanged.", -1, 10, 210, 420, 40
    PUSHBUTTON "Use adaptive SBC", IDC_EVENT_FALLBACK, 10, 258, 130, 20
    DEFPUSHBUTTON "Close", IDCANCEL, 350, 258, 80, 20
END

// ------------------------------------------------------------------------------------
IDD_PAGE_WINDOWS DIALOGEX 0, 0, 400, 262
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
