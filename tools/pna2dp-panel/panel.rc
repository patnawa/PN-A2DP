    LTEXT           "Latency trims:", -1, 230, 80, 62, 10
    LTEXT           "", IDC_ST_TRIMS, 294, 80, 98, 10
    LTEXT           "TX queue:", -1, 230, 91, 62, 10
    LTEXT           "", IDC_ST_QUEUE, 294, 91, 98, 10
    LTEXT           "TX completion:", -1, 230, 102, 62, 10
    LTEXT           "", IDC_ST_TXTIME, 294, 102, 98, 10
    LTEXT           "ABR:", -1, 230, 113, 62, 10
