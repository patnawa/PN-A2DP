IDD_PAGE_CODECS DIALOGEX 0, 0, 400, 262
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_CODEC_LIVE, 4, 2, 392, 20, SS_NOPREFIX
    LTEXT           "Checks allow codecs in priority order. Receiver support, live state and saved preferences are shown separately.", -1, 4, 24, 392, 16
    CONTROL         "", IDC_CODEC_LIST, WC_LISTVIEW, WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER, 4, 42, 392, 90
    PUSHBUTTON      "Move up", IDC_CODEC_UP, 4, 136, 54, 16
    PUSHBUTTON      "Move down", IDC_CODEC_DOWN, 62, 136, 62, 16
    PUSHBUTTON      "Activate selected", IDC_CODEC_ACTIVATE, 128, 136, 126, 16
    PUSHBUTTON      "Auto quality + codecs", IDC_CODEC_ENABLEALL, 258, 136, 138, 16
    GROUPBOX        "Load a preset", -1, 4, 157, 392, 48
    COMBOBOX        IDC_PRESET, 10, 169, 210, 100, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    PUSHBUTTON      "Load preset", IDC_PRESET_APPLY, 226, 168, 64, 14
    LTEXT           "", IDC_PRESET_DESC, 10, 185, 380, 18, SS_NOPREFIX
    CONTROL         "Prefer codec host encoders (kernel SBC remains the safety fallback)", IDC_CODEC_HOSTONLY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 4, 211, 392, 10
    CONTROL         "Apply codec changes live (renegotiate the stream without disconnecting the receiver)", IDC_CODEC_APPLYLIVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 4, 225, 392, 10
    LTEXT           "", IDC_CODEC_NOTE, 4, 239, 392, 22
END

// ------------------------------------------------------------------------------------
IDD_PAGE_SBC DIALOGEX 0, 0, 400, 262
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Bitpool", -1, 4, 2, 392, 76
    LTEXT           "Maximum bitpool:", -1, 10, 16, 60, 10
    CONTROL         "", IDC_SBC_MAX_SLIDER, TRACKBAR_CLASS, WS_TABSTOP | TBS_HORZ | TBS_AUTOTICKS | TBS_TOOLTIPS, 72, 13, 196, 15
    EDITTEXT        IDC_SBC_MAX_EDIT, 272, 14, 30, 12, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "", IDC_SBC_MAX_SPIN, UPDOWN_CLASS, UDS_ALIGNRIGHT | UDS_SETBUDDYINT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 302, 14, 10, 12
    CONTROL         "Headset maximum", IDC_SBC_MAX_SINK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 318, 15, 76, 10
    LTEXT           "Minimum bitpool:", -1, 10, 34, 60, 10
    EDITTEXT        IDC_SBC_MIN_EDIT, 72, 32, 30, 12, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "", IDC_SBC_MIN_SPIN, UPDOWN_CLASS, UDS_ALIGNRIGHT | UDS_SETBUDDYINT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 102, 32, 10, 12
    LTEXT           "(the ABR controller never goes below this)", -1, 118, 34, 200, 10
    CONTROL         "Allow a bitpool above the headset's advertised maximum (a headset may reject it)", IDC_SBC_OVERRIDE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 49, 380, 10
    CONTROL         "Prefer dual channel over joint stereo (each channel gets its own bitpool)", IDC_SBC_DUAL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 62, 380, 10

    GROUPBOX        "Sample rates", -1, 4, 82, 96, 76
    CONTROL         "16 kHz", IDC_SBC_R16, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 106, 80, 10
    CONTROL         "32 kHz", IDC_SBC_R32, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 118, 80, 10
    CONTROL         "44.1 kHz", IDC_SBC_R44, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 130, 80, 10
    CONTROL         "48 kHz", IDC_SBC_R48, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 142, 80, 10
    GROUPBOX        "Channel modes", -1, 104, 82, 96, 76
    CONTROL         "Mono", IDC_SBC_CMONO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 110, 106, 80, 10
    CONTROL         "Dual channel", IDC_SBC_CDUAL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 110, 118, 80, 10
    CONTROL         "Stereo", IDC_SBC_CSTEREO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 110, 130, 80, 10
    CONTROL         "Joint stereo", IDC_SBC_CJOINT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 110, 142, 80, 10
    GROUPBOX        "Blocks", -1, 204, 82, 60, 76
    CONTROL         "4", IDC_SBC_B4, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 210, 106, 48, 10
    CONTROL         "8", IDC_SBC_B8, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 210, 118, 48, 10
    CONTROL         "12", IDC_SBC_B12, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 210, 130, 48, 10
    CONTROL         "16", IDC_SBC_B16, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 210, 142, 48, 10
    GROUPBOX        "Subbands", -1, 268, 82, 60, 52
    CONTROL         "4", IDC_SBC_S4, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 274, 106, 48, 10
    CONTROL         "8", IDC_SBC_S8, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 274, 118, 48, 10
    GROUPBOX        "Allocation", -1, 332, 82, 64, 52
    CONTROL         "Loudness", IDC_SBC_ALOUD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 338, 106, 54, 10
    CONTROL         "SNR", IDC_SBC_ASNR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 338, 118, 54, 10
    CONTROL         "SBC XQ: dual channel, 16 blocks, 8 subbands, packed to the radio packets (overrides the choices above)", IDC_SBC_XQ, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 162, 386, 10
    LTEXT           "", IDC_SBC_BITRATE, 4, 176, 392, 22, SS_NOPREFIX
    LTEXT           "", IDC_SBC_NOTE, 4, 200, 392, 58, SS_NOPREFIX
    CONTROL         "Auto", IDC_SBC_RAUTO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 94, 80, 10
    CONTROL         "Auto", IDC_SBC_CAUTO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 110, 94, 80, 10
    CONTROL         "Auto", IDC_SBC_BAUTO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 210, 94, 48, 10
    CONTROL         "Auto", IDC_SBC_SAUTO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 274, 94, 48, 10
    CONTROL         "Auto", IDC_SBC_AAUTO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 338, 94, 54, 10

END

