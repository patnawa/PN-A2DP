    GROUPBOX        "Behaviour", -1, 4, 118, 392, 80
    CONTROL         "Suspend the stream during calls (SCO link active) and resume afterwards", IDC_TR_SUSPENDSCO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 130, 380, 10
    CONTROL         "Start streaming as soon as the headset connects (even while Windows is silent)", IDC_TR_AUTOSTART, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 143, 380, 10
    CONTROL         "Accept AVDTP delay reports from the headset for lip-sync", IDC_TR_DELAYREPORT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 156, 380, 10
    CONTROL         "Expose all sample rates to Windows (exclusive mode players can pick 88.2 / 96 kHz)", IDC_TR_ALLRATES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 169, 380, 10
    CONTROL         "Automatic receiver volume, with software volume fallback", IDC_TR_SWVOLUME, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 182, 380, 10
