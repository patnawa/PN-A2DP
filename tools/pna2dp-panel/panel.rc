    LTEXT           "Default output:", -1, 4, 86, 72, 12
    LTEXT           "", IDC_WIN_DEFAULT, 82, 86, 314, 12, SS_NOPREFIX
    LTEXT           "Output volume", -1, 4, 111, 72, 12
    CONTROL         "", IDC_WIN_VOLUME, TRACKBAR_CLASS, WS_TABSTOP | TBS_HORZ | TBS_AUTOTICKS | TBS_TOOLTIPS, 78, 106, 214, 23
    LTEXT           "", IDC_WIN_LEVEL, 300, 111, 39, 12
    CONTROL         "Mute", IDC_WIN_MUTE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 346, 111, 50, 12
    LTEXT           "", IDC_WIN_ADAPTER, 4, 139, 392, 14, SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT           "", IDC_WIN_DRIVER, 4, 157, 392, 14, SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT           "", IDC_WIN_NOTE, 4, 179, 392, 52, SS_NOPREFIX
    PUSHBUTTON      "Sound settings", IDC_WIN_SOUND, 4, 241, 94, 16
    PUSHBUTTON      "Bluetooth settings", IDC_WIN_BLUETOOTH, 104, 241, 98, 16
    PUSHBUTTON      "Refresh", IDC_WIN_REFRESH, 208, 241, 64, 16
    PUSHBUTTON      "Details...", IDC_WIN_DETAILS, 278, 241, 68, 16
END

