// setup.rc - PN-A2DP installer dialogs and embedded payload. SPDX-License-Identifier: MIT
#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "../pna2dp-panel/version.h"
#include "payload.rc"       // generated by build.ps1 (PAYLOAD resources)

#pragma code_page(65001)

IDI_APP ICON "app.ico"
IDR_MANIFEST RT_MANIFEST "setup.manifest"

IDD_WIZARD DIALOGEX 0, 0, 400, 282
STYLE DS_SETFONT | DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "PN-A2DP Setup"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            IDI_APP, IDC_WZ_ICON, 8, 6, 20, 20
    LTEXT           "", IDC_WZ_TITLE, 34, 7, 358, 12, SS_NOPREFIX
    LTEXT           "", IDC_WZ_SUBTITLE, 34, 20, 358, 10, SS_NOPREFIX
    CONTROL         "", IDC_WZ_LINE, "Static", SS_ETCHEDHORZ, 0, 34, 400, 1
    CONTROL         "", -1, "Static", SS_ETCHEDHORZ, 0, 252, 400, 1
    PUSHBUTTON      "< Back", IDC_WZ_BACK, 230, 260, 50, 14
    DEFPUSHBUTTON   "Next >", IDC_WZ_NEXT, 284, 260, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 342, 260, 50, 14
END

IDD_WZ_WELCOME DIALOGEX 0, 0, 386, 210
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_WELCOME_TEXT, 4, 4, 378, 200, SS_NOPREFIX
END

IDD_WZ_LICENSE DIALOGEX 0, 0, 386, 210
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_LICENSE_TEXT, 4, 4, 378, 180, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    CONTROL         "I accept the MIT license and the third-party notices", IDC_LICENSE_ACCEPT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 4, 192, 300, 10
END

IDD_WZ_COMPONENTS DIALOGEX 0, 0, 386, 210
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Select the components to install:", -1, 4, 4, 378, 10
    CONTROL         "", IDC_COMP_LIST, WC_LISTVIEW, WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER, 4, 16, 200, 150
    LTEXT           "", IDC_COMP_DESC, 212, 16, 170, 150, SS_NOPREFIX
    LTEXT           "", IDC_COMP_SIZE, 4, 172, 378, 10
    LTEXT           "The codec host service and its plugins are what makes LDAC, aptX and AAC available; without them the driver streams SBC only.", -1, 4, 186, 378, 20
END

IDD_WZ_FOLDER DIALOGEX 0, 0, 386, 210
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Install PN-A2DP to this folder:", -1, 4, 4, 378, 10
    EDITTEXT        IDC_FOLDER_EDIT, 4, 16, 320, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_FOLDER_BROWSE, 328, 15, 54, 14
    LTEXT           "", IDC_FOLDER_NOTE, 4, 36, 378, 60, SS_NOPREFIX
END

IDD_WZ_DEVICES DIALOGEX 0, 0, 386, 210
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Choose which paired Bluetooth stereo devices use the PN-A2DP driver. Unchecked devices keep the Microsoft driver; you can switch any device later in the control panel.", -1, 4, 4, 378, 20
    CONTROL         "", IDC_DEV_LIST, WC_LISTVIEW, WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER, 4, 28, 378, 140
    PUSHBUTTON      "Select all", IDC_DEV_ALL, 4, 172, 60, 14
    PUSHBUTTON      "Select none", IDC_DEV_NONE, 68, 172, 60, 14
    LTEXT           "", IDC_DEV_NOTE, 4, 190, 378, 18, SS_NOPREFIX
END

IDD_WZ_SIGNING DIALOGEX 0, 0, 386, 210
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_SIGN_INFO, 4, 4, 378, 90, SS_NOPREFIX
    LTEXT           "", IDC_SIGN_NOTE, 4, 102, 378, 100, SS_NOPREFIX
END

IDD_WZ_PROGRESS DIALOGEX 0, 0, 386, 210
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_PROG_STEP, 4, 4, 378, 10, SS_NOPREFIX
    CONTROL         "", IDC_PROG_BAR, PROGRESS_CLASS, WS_BORDER, 4, 16, 378, 10
    LISTBOX         IDC_PROG_LOG, 4, 32, 378, 174, LBS_NOINTEGRALHEIGHT | LBS_NOSEL | WS_VSCROLL | WS_HSCROLL | WS_BORDER
END

IDD_WZ_FINISH DIALOGEX 0, 0, 386, 210
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_FINISH_TEXT, 4, 4, 378, 150, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | NOT WS_BORDER
    CONTROL         "Open the PN-A2DP Control Panel now", IDC_FINISH_LAUNCH, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 4, 160, 300, 10
    CONTROL         "Restart the computer now", IDC_FINISH_REBOOT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 4, 176, 300, 10
END

IDD_WZ_UNINSTALL DIALOGEX 0, 0, 386, 210
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_UNINST_TEXT, 4, 4, 378, 200, SS_NOPREFIX
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PN_PANEL_VERSION_NUMBERS
 PRODUCTVERSION PN_PANEL_VERSION_NUMBERS
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PN-A2DP Project"
            VALUE "FileDescription", "PN-A2DP Setup"
            VALUE "FileVersion", PN_PANEL_VERSION_TEXT
            VALUE "InternalName", "pna2dp-setup"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "pna2dp-setup.exe"
            VALUE "ProductName", "PN-A2DP"
            VALUE "ProductVersion", PN_PANEL_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
